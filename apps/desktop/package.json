{
  "name": "@guhbot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "guhbot desktop client: an Electron shell around an embedded host.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:main": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "vite",
    "start": "electron ."
  },
  "dependencies": {
    "@guhbot/agent": "workspace:*",
    "@guhbot/host-core": "workspace:*",
    "@guhbot/protocol": "workspace:*",
    "@guhbot/server": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.8.6",
    "vite": "^8.3.4"
  }
}
