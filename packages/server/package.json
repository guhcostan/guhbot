{
  "name": "@guhbot/server",
  "version": "0.1.0",
  "private": true,
  "description": "Host server: WebSocket transport, pairing, and event fan-out for desktop, mobile and cloud clients.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "guhbot-host": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@guhbot/agent": "workspace:*",
    "@guhbot/host-core": "workspace:*",
    "@guhbot/protocol": "workspace:*",
    "ws": "^8.18.0",
    "@guhbot/browser": "workspace:*",
    "@guhbot/mcp": "workspace:*",
    "@guhbot/messages": "workspace:*",
    "@guhbot/canvas": "workspace:*",
    "@guhbot/scheduler": "workspace:*",
    "@guhbot/engine-cli": "workspace:*",
    "@guhbot/companion": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
