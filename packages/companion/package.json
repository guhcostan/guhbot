{
  "name": "@guhbot/companion",
  "version": "0.1.0",
  "private": true,
  "description": "Network-facing sidecar: the only guhbot process that binds a network interface, fronting the loopback-only harness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
